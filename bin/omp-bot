#!/usr/bin/env bash
# omp-bot — Clean-slate profile launcher for Tern-Bot (`~/.config/omp-bot`).
# Starts OMP from a fresh agent directory (`PI_CODING_AGENT_DIR=~/.config/omp-bot`)
# symlinked to `tern-bot/profile/`, sharing only model gateway & auth from `~/.omp/agent`
# while leaving behind the main coding agent's heavy rules and extension stack.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
TERN_BOT_ROOT="$(cd -P "${BIN_DIR}/.." && pwd)"

OMP_BOT_HOME="${OMP_BOT_HOME:-${HOME}/.config/omp-bot}"
MAIN_OMP_AGENT="${HOME}/.omp/agent"

mkdir -p "${OMP_BOT_HOME}/sessions" "${OMP_BOT_HOME}/extensions"

# 1. Link clean-slate config & persona from repo profile/
ln -sfn "${TERN_BOT_ROOT}/profile/config.yml"     "${OMP_BOT_HOME}/config.yml"
ln -sfn "${TERN_BOT_ROOT}/profile/AGENTS.md"      "${OMP_BOT_HOME}/AGENTS.md"
ln -sfn "${TERN_BOT_ROOT}/profile/PERSONALITY.md" "${OMP_BOT_HOME}/PERSONALITY.md"

# 2. Link only model gateway, lane definitions, and auth DB from ~/.omp/agent (no rules/extensions clutter)
for shared in models.yml agents agent.db; do
  if [ -e "${MAIN_OMP_AGENT}/${shared}" ] && [ ! -e "${OMP_BOT_HOME}/${shared}" ]; then
    ln -s "${MAIN_OMP_AGENT}/${shared}" "${OMP_BOT_HOME}/${shared}"
  fi
done

# 3. Link Tern-Bot's own extension into the clean profile
ln -sfn "${TERN_BOT_ROOT}/packages/bot-daemon/src/extension.ts" "${OMP_BOT_HOME}/extensions/tern-bot.ts"

export TERN_BOT_PROFILE="1"
export TERN_BOT_ROOT="${TERN_BOT_ROOT}"
export PI_CODING_AGENT_DIR="${OMP_BOT_HOME}"

exec omp "$@"
